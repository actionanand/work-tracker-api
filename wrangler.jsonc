/**
 * For more details on how to configure Wrangler, refer to:
 * https://developers.cloudflare.com/workers/wrangler/configuration/
 */
{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "work-tracker-api",
	"main": "src/index.ts",
	"compatibility_date": "2026-08-31",
	"observability": {
		"enabled": true
	},
	"upload_source_maps": true,
	/**
	 * Smart Placement
	 * https://developers.cloudflare.com/workers/configuration/smart-placement/#smart-placement
	 */
	// "placement": {  "mode": "smart" }
	/**
	 * Bindings
	 * Bindings allow your Worker to interact with resources on the Cloudflare Developer Platform, including
	 * databases, object storage, AI inference, real-time communication and more.
	 * https://developers.cloudflare.com/workers/runtime-apis/bindings/
	 */
	/**
	 * Environment Variables
	 * https://developers.cloudflare.com/workers/wrangler/configuration/#environment-variables
	 * Note: Use secrets to store sensitive data.
	 * https://developers.cloudflare.com/workers/configuration/secrets/
	 */
	"vars": {
		"JIRAS_DATA_SOURCE_ID": "3cc87ffa-ee01-80b4-abcd-000ba40dd653",
		"SPRINTS_DATA_SOURCE_ID": "3cc87ffa-ee01-8024-bc36-000b4954e5a9",
		"SPRINT_ALLOCATIONS_DATA_SOURCE_ID": "3cd87ffa-ee01-80c9-bd21-000b92696f23",
		"PROJECTS_DATA_SOURCE_ID": "3cc87ffa-ee01-804f-a80e-000bbde7cf37",
		"COMPANIES_DATA_SOURCE_ID": "3cc87ffa-ee01-8026-843a-000b4c2368a8",
		"TEAMS_DATA_SOURCE_ID": "3cc87ffa-ee01-80b7-bb62-000b8d43ebc0",
		"WORK_LOGS_DATA_SOURCE_ID": "3cc87ffa-ee01-80b7-bf73-000b346f321b",
		"RELEASE_ITEMS_DATA_SOURCE_ID": "3cf87ffa-ee01-802b-a76c-000bd0e690f3",
		"FEEDBACK_DATA_SOURCE_ID": "3cf87ffa-ee01-805e-ad5a-000b521af7e6",
		"WORK_LINKS_DATA_SOURCE_ID": "3cd87ffa-ee01-802f-a644-000b6e7b671c",
		"TODOS_DATA_SOURCE_ID": "3cc87ffa-ee01-80f6-92b0-000b217b510b",
		"TASKS_DATA_SOURCE_ID": "3d987ffa-ee01-8036-a0c6-000b233b4748",
		"MEMOS_DATA_SOURCE_ID": "3d987ffa-ee01-80a4-ada9-000b575514e4",
		"REFERENCE_LIBRARY_PAGE_ID": "3d987ffa-ee01-80e6-b336-d5e610dbbf7c",
		"AUTH_PASSWORD_ITERATIONS": "100000",
		"AUTH_TOKEN_TTL_SECONDS": "3600",
		"AUTH_RENEW_WINDOW_SECONDS": "900",
		"AUTH_MAX_SESSION_SECONDS": "28800"
	},
	"ratelimits": [
		{
			"name": "AUTH_RATE_LIMITER",
			"namespace_id": "2026090301",
			"simple": {
				"limit": 5,
				"period": 60
			}
		}
	],
	"d1_databases": [
		{
			"binding": "AUTH_DB",
			"database_name": "work-tracker-auth",
			"database_id": "68b3c13b-e597-4a87-8afa-e1926c5d7849"
		}
	]
	/**
	 * Static Assets
	 * https://developers.cloudflare.com/workers/static-assets/binding/
	 */
	// "assets": {  "directory": "./public/",  "binding": "ASSETS" }
	/**
	 * Service Bindings (communicate between multiple Workers)
	 * https://developers.cloudflare.com/workers/wrangler/configuration/#service-bindings
	 */
	// "services": [  {   "binding": "MY_SERVICE",   "service": "my-service"  } ]
}
